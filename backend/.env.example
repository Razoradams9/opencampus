# Copy to backend/.env and replace every <...> value.  Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

OPENCAMPUS_ENV=development

# Host port for the Docker Postgres. Change it (and the URLs below) if 5432 is
# taken or reserved, e.g. on Windows: OPENCAMPUS_DB_PORT=55432
OPENCAMPUS_DB_PORT=5432

# --- Database roles (used by docker-compose and db/init/01-roles.sh) ------
OPENCAMPUS_DB_SUPERUSER_PASSWORD=<generate>
OPENCAMPUS_DB_OWNER_PASSWORD=<generate>
OPENCAMPUS_DB_APP_PASSWORD=<generate>

# Runtime: the non-owner app role, so row-level security applies.
OPENCAMPUS_DATABASE_URL=postgresql+psycopg://opencampus_app:<app password>@127.0.0.1:5432/opencampus
# Migrations only: the schema-owner role.
OPENCAMPUS_MIGRATION_DATABASE_URL=postgresql+psycopg://opencampus_owner:<owner password>@127.0.0.1:5432/opencampus
# Tests: a separate database whose name contains "test".
OPENCAMPUS_TEST_DATABASE_URL=postgresql+psycopg://opencampus_app:<app password>@127.0.0.1:5432/opencampus_test
OPENCAMPUS_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://opencampus_owner:<owner password>@127.0.0.1:5432/opencampus_test

# --- Tokens --------------------------------------------------------------
# HS256 signing key, at least 32 characters. Rotating it signs everyone out
# of access tokens (refresh cookies keep working).
OPENCAMPUS_JWT_SECRET=<generate>
# OPENCAMPUS_ACCESS_TOKEN_TTL_SECONDS=600
# OPENCAMPUS_REFRESH_TOKEN_TTL_SECONDS=604800
# OPENCAMPUS_SESSION_MAX_AGE_SECONDS=2592000
# OPENCAMPUS_REFRESH_REUSE_GRACE_SECONDS=20

# --- Rate limiting -------------------------------------------------------
# HMAC key for rate-limit identifiers (emails/IPs/sessions are never stored raw).
# At least 32 characters and different from OPENCAMPUS_JWT_SECRET.
OPENCAMPUS_RATE_LIMIT_SECRET=<generate>
# Policies: comma-separated "limit/seconds" fixed windows. Defaults shown.
# OPENCAMPUS_RATE_LIMIT_LOGIN_IP=5/60,20/3600
# OPENCAMPUS_RATE_LIMIT_LOGIN_ACCOUNT=5/900,20/3600      (failed attempts per email)
# OPENCAMPUS_RATE_LIMIT_REGISTER_IP=3/3600
# OPENCAMPUS_RATE_LIMIT_REFRESH_SESSION=30/60,120/3600
# OPENCAMPUS_RATE_LIMIT_REFRESH_IP=120/60,1200/3600
# Reverse proxies whose X-Forwarded-For may be trusted (IPs or CIDRs, comma-
# separated). Leave empty unless the API sits behind your own proxy. Run uvicorn
# with --no-proxy-headers so this is the only layer reading forwarding headers.
# OPENCAMPUS_TRUSTED_PROXIES=10.0.0.0/8

# Password-reset limits (defaults shown).
# OPENCAMPUS_RATE_LIMIT_RESET_REQUEST_IP=5/900,20/3600
# OPENCAMPUS_RATE_LIMIT_RESET_REQUEST_ACCOUNT=3/3600    (per email, existing or not)
# OPENCAMPUS_RATE_LIMIT_RESET_CONFIRM_IP=10/900,30/3600

# --- Password recovery and email ----------------------------------------
# Public URL of the frontend. Reset links are built from this, never from the
# request's Host header. Required (and must be https) in production.
OPENCAMPUS_FRONTEND_URL=http://localhost:5173
# OPENCAMPUS_PASSWORD_RESET_TTL_SECONDS=1800

# Delivery mode: "dev_file" writes emails to backend/.dev-mail/ instead of
# sending them (refused when OPENCAMPUS_ENV=production); "smtp" sends them.
# Defaults to dev_file unless OPENCAMPUS_SMTP_HOST is set.
OPENCAMPUS_EMAIL_MODE=dev_file
# OPENCAMPUS_EMAIL_DEV_DIR=.dev-mail

# SMTP (production). TLS: "starttls" (port 587, default), "ssl" (465) or
# "none" (local relays only; refused in production and with credentials).
# OPENCAMPUS_SMTP_HOST=smtp.your-provider.example
# OPENCAMPUS_SMTP_PORT=587
# OPENCAMPUS_SMTP_TLS=starttls
# OPENCAMPUS_SMTP_USERNAME=<username>
# OPENCAMPUS_SMTP_PASSWORD=<password>
# OPENCAMPUS_EMAIL_FROM=OpenCampus <no-reply@your-college.example>

# --- Cookies -------------------------------------------------------------
# false ONLY for plain-http local development. Must be true in production
# (the app refuses to start otherwise).
OPENCAMPUS_COOKIE_SECURE=false
# OPENCAMPUS_COOKIE_SAMESITE=strict

# Origins allowed for CORS and for the CSRF Origin check (comma-separated).
# OPENCAMPUS_CORS_ORIGINS=http://localhost:5173
