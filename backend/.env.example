# Copy to backend/.env and replace every <...> value.  Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

OPENCAMPUS_ENV=development

# --- Database roles (used by docker-compose and db/init/01-roles.sh) ------
OPENCAMPUS_DB_SUPERUSER_PASSWORD=<generate>
OPENCAMPUS_DB_OWNER_PASSWORD=<generate>
OPENCAMPUS_DB_APP_PASSWORD=<generate>

# Runtime: the non-owner app role, so row-level security applies.
OPENCAMPUS_DATABASE_URL=postgresql+psycopg://opencampus_app:<app password>@127.0.0.1:5432/opencampus
# Migrations only: the schema-owner role.
OPENCAMPUS_MIGRATION_DATABASE_URL=postgresql+psycopg://opencampus_owner:<owner password>@127.0.0.1:5432/opencampus
# Tests: a separate database whose name contains "test".
OPENCAMPUS_TEST_DATABASE_URL=postgresql+psycopg://opencampus_app:<app password>@127.0.0.1:5432/opencampus_test
OPENCAMPUS_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://opencampus_owner:<owner password>@127.0.0.1:5432/opencampus_test

# --- Tokens --------------------------------------------------------------
# HS256 signing key, at least 32 characters. Rotating it signs everyone out
# of access tokens (refresh cookies keep working).
OPENCAMPUS_JWT_SECRET=<generate>
# OPENCAMPUS_ACCESS_TOKEN_TTL_SECONDS=600
# OPENCAMPUS_REFRESH_TOKEN_TTL_SECONDS=604800
# OPENCAMPUS_SESSION_MAX_AGE_SECONDS=2592000
# OPENCAMPUS_REFRESH_REUSE_GRACE_SECONDS=20

# --- Cookies -------------------------------------------------------------
# false ONLY for plain-http local development. Must be true in production
# (the app refuses to start otherwise).
OPENCAMPUS_COOKIE_SECURE=false
# OPENCAMPUS_COOKIE_SAMESITE=strict

# Origins allowed for CORS and for the CSRF Origin check (comma-separated).
# OPENCAMPUS_CORS_ORIGINS=http://localhost:5173
